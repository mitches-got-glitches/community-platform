# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored.
# Do NOT put the Hetzner API token here; pass it via the HCLOUD_TOKEN env var
# instead (see README.md). Terraform vars files are plaintext on disk, so keep
# secrets out of this file entirely.

server_name = "community-platform"
server_type = "cax31"
location    = "fsn1"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Restrict SSH to your known IP(s) once you have them; leaving this as
# 0.0.0.0/0 relies on key-only auth (INFRA-4) as the sole SSH defence.
# admin_ipv4_cidrs = ["203.0.113.4/32"]
